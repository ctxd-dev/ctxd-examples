# Copy to .env on your Docker host. Keep .env private and out of Git.
# Obtain your own key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Application caps, not provider quotas. Set below the project's actual AI Studio allowance.
MODEL_RPM=3
MODEL_RPD=50
MODEL_TPM=60000
VISITOR_10_MIN=5
VISITOR_DAY=20
# GitHub default branch, checked every five minutes. A commit hash pins a publication.
DOCS_REF=HEAD
SYNC_SECONDS=300
# Loopback by default. Choose an authorized host interface for remote development.
WEB_BIND=127.0.0.1
WEB_PORT=8840
# Empty unless the origin is reachable only through explicitly trusted tunnel proxies.
TRUSTED_PROXY_NETWORKS=
# Optional shared secret for a deployment proxy; leave empty for direct development.
ORIGIN_AUTH_TOKEN=
